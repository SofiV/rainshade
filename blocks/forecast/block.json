{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rainshade/forecast",
	"title": "Forecast tracklist",
	"category": "text",
	"icon": "playlist-audio",
	"description": "Tracklist as a weather forecast: bpm and chance of tears.",
	"textdomain": "rainshade",
	"attributes": {
		"headLeft": { "type": "string", "default": "forecast for fall" },
		"headRight": { "type": "string", "default": "chance of tears" }
	},
	"supports": { "html": false },
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
