{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rainshade/release",
	"title": "Release",
	"category": "media",
	"icon": "album",
	"description": "Section: album cover, title and the forecast tracklist.",
	"textdomain": "rainshade",
	"attributes": {
		"mediaId": { "type": "number" },
		"mediaUrl": { "type": "string", "default": "" },
		"eyebrow": { "type": "string", "default": "debut album · 30.10.2026" },
		"title": { "type": "string", "default": "fall" },
		"linkUrl": { "type": "string", "default": "https://linktr.ee/rainshade" },
		"linkText": { "type": "string", "default": "listen everywhere ↗" }
	},
	"supports": { "html": false, "anchor": true, "align": [ "wide", "full" ] },
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
