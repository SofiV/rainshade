{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rainshade/visuals",
	"title": "Visuals",
	"category": "media",
	"icon": "video-alt3",
	"description": "Section: heading and a video — YouTube/Vimeo embed or a media library file (optional).",
	"textdomain": "rainshade",
	"attributes": {
		"heading": { "type": "string", "default": "visuals" },
		"note": { "type": "string", "default": "" },
		"linkUrl": { "type": "string", "default": "" },
		"linkText": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "anchor": true, "align": [ "wide", "full" ] },
	"editorScript": "file:./editor.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
